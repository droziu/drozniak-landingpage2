{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js (dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Vercel dev (with API routes)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:vercel"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Next.js (running :3000)",
      "url": "http://localhost:3000"
    }
  ]
}
